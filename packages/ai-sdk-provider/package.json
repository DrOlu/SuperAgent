{
  "name": "@cherrystudio/ai-sdk-provider",
  "version": "0.1.6",
  "description": "SuperAgent AI SDK provider bundle with CherryIN routing.",
  "keywords": [
    "ai-sdk",
    "superagent",
    "cherryin",
    "provider",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/DrOlu/SuperAgent",
  "bugs": {
    "url": "https://github.com/DrOlu/SuperAgent/issues"
  },
  "license": "MIT",
  "author": "SuperAgent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrOlu/SuperAgent.git",
    "directory": "packages/ai-sdk-provider"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "pnpm --workspace-root exec tsc -w -p packages/ai-sdk-provider/tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.15",
    "@ai-sdk/provider-utils": "^4.0.48"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.113",
    "@ai-sdk/openai": "^3.0.109",
    "@ai-sdk/openai-compatible": "^2.0.72"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
